<?xml version='1.0' encoding='UTF-8'?>
<mujoco>

	<option timestep="1e-4"/>
	<option gravity="0 0 -9.8"/>

    <worldbody>

        <!--Polygon-->
        <body name="floor" pos="0 0 0">
            <geom type="plane" size="10 10 0.1"/>
        </body>
        <!--Rover starts here-->
        <!--Base body-->
        <body pos = "0 0 1">
            <joint name = "cart" type = "free"/>
            <geom type = "box" size = "1 0.6 0.1"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.9 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.3 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.3 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.9 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.9 -0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.3 -0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.3 -0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.9 -0.5 -0.2"/>

            <!--First Pair-->

            <body pos = "0.25 0 -0.2">

                <geom type = "box" size = "0.05 0.25 0.1" rgba = "1 1 0 1"/>
                <body pos = "0 0.275 0">
                    <geom type = "cylinder" size = "0.05 0.025" euler = "90 0 0" rgba = "1 1 0 1"/>
                    <body pos = "0.15 0.05 0">
                        <joint type = "hinge" axis = "1 0 0" stiffness="10000" damping="10"/>
                        <geom type = "cylinder" euler = "0 90 0" size = "0.02 0.2" rgba = "0 0 1 1"/>
                        <body pos = "0.2 0.15 0">
                            <joint type = "hinge" axis = "0 1 0"/>
                            <geom type = "cylinder" size = "0.02 0.2" euler = "90 0 0" rgba = "1 0 0 1"/>
                            <body pos = "0 0.25 0">
                                <joint  name = "wheelL1" type = "hinge" axis = "0 1 0"/>
                                <geom type = "cylinder" size = "0.2 0.05" euler = "90 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
                <body pos = "0 -0.275 0">
                    <geom type = "cylinder" size = "0.05 0.025" euler = "90 0 0" rgba = "1 1 0 1"/>
                    <body pos = "0.15 -0.05 0">
                        <joint type = "hinge" axis = "1 0 0" stiffness="10000" damping="10"/>
                        <geom type = "cylinder" euler = "0 90 0" size = "0.02 0.2" rgba = "0 0 1 1"/>
                        <body pos = "0.2 -0.15 0">
                            <joint type = "hinge" axis = "0 1 0"/>
                            <geom type = "cylinder" size = "0.02 0.2" euler = "90 0 0" rgba = "1 0 0 1"/>
                            <body pos = "0 -0.25 0">
                                <joint  name = "wheelR1" type = "hinge" axis = "0 1 0"/>
                                <geom type = "cylinder" size = "0.2 0.05" euler = "90 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <!--Second Pair-->

            <body pos = "-0.35 0 -0.2">

                <geom type = "box" size = "0.05 0.25 0.1" rgba = "1 1 0 1"/>
                <body pos = "0 0.275 0">
                    <geom type = "cylinder" size = "0.05 0.025" euler = "90 0 0" rgba = "1 1 0 1"/>
                    <body pos = "0.15 0.05 0">
                        <joint type = "hinge" axis = "1 0 0" stiffness="10000" damping="10"/>
                        <geom type = "cylinder" euler = "0 90 0" size = "0.02 0.2" rgba = "0 0 1 1"/>
                        <body pos = "0.2 0.15 0">
                            <joint type = "hinge" axis = "0 1 0"/>
                            <geom type = "cylinder" size = "0.02 0.2" euler = "90 0 0" rgba = "1 0 0 1"/>
                            <body pos = "0 0.25 0">
                                <joint  name = "wheelL2" type = "hinge" axis = "0 1 0"/>
                                <geom type = "cylinder" size = "0.2 0.05" euler = "90 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
                <body pos = "0 -0.275 0">
                    <geom type = "cylinder" size = "0.05 0.025" euler = "90 0 0" rgba = "1 1 0 1"/>
                    <body pos = "0.15 -0.05 0">
                        <joint type = "hinge" axis = "1 0 0" stiffness="10000" damping="10"/>
                        <geom type = "cylinder" euler = "0 90 0" size = "0.02 0.2" rgba = "0 0 1 1"/>
                        <body pos = "0.2 -0.15 0">
                            <joint type = "hinge" axis = "0 1 0"/>
                            <geom type = "cylinder" size = "0.02 0.2" euler = "90 0 0" rgba = "1 0 0 1"/>
                            <body pos = "0 -0.25 0">
                                <joint  name = "wheelR2" type = "hinge" axis = "0 1 0"/>
                                <geom type = "cylinder" size = "0.2 0.05" euler = "90 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>

            <!--Third Pair-->

            <body pos = "-0.95 0 -0.2">

                <geom type = "box" size = "0.05 0.25 0.1" rgba = "1 1 0 1"/>
                <body pos = "0 0.275 0">
                    <geom type = "cylinder" size = "0.05 0.025" euler = "90 0 0" rgba = "1 1 0 1"/>
                    <body pos = "0.15 0.05 0">
                        <joint type = "hinge" axis = "1 0 0" stiffness="10000" damping="10"/>
                        <geom type = "cylinder" euler = "0 90 0" size = "0.02 0.2" rgba = "0 0 1 1"/>
                        <body pos = "0.2 0.15 0">
                            <joint type = "hinge" axis = "0 1 0"/>
                            <geom type = "cylinder" size = "0.02 0.2" euler = "90 0 0" rgba = "1 0 0 1"/>
                            <body pos = "0 0.25 0">
                                <joint  name = "wheelL3" type = "hinge" axis = "0 1 0"/>
                                <geom type = "cylinder" size = "0.2 0.05" euler = "90 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
                <body pos = "0 -0.275 0">
                    <geom type = "cylinder" size = "0.05 0.025" euler = "90 0 0" rgba = "1 1 0 1"/>
                    <body pos = "0.15 -0.05 0">
                        <joint type = "hinge" axis = "1 0 0" stiffness="10000" damping="10"/>
                        <geom type = "cylinder" euler = "0 90 0" size = "0.02 0.2" rgba = "0 0 1 1"/>
                        <body pos = "0.2 -0.15 0">
                            <joint type = "hinge" axis = "0 1 0"/>
                            <geom type = "cylinder" size = "0.02 0.2" euler = "90 0 0" rgba = "1 0 0 1"/>
                            <body pos = "0 -0.25 0">
                                <joint  name = "wheelR3" type = "hinge" axis = "0 1 0"/>
                                <geom type = "cylinder" size = "0.2 0.05" euler = "90 0 0"/>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
             

        </body>
    </worldbody>

    <actuator>
        <motor name="firstMotor" joint="wheelL1" ctrllimited="true" ctrlrange="-100 100" gear="20"/>
        <motor name="secondMotor" joint="wheelR1" ctrllimited="true" ctrlrange="-100 100" gear="20"/>
        <motor name="thirdMotor" joint="wheelL2" ctrllimited="true" ctrlrange="-100 100" gear="20"/>
        <motor name="fourthMotor" joint="wheelR2" ctrllimited="true" ctrlrange="-100 100" gear="20"/>
        <motor name="fifthMotor" joint="wheelL3" ctrllimited="true" ctrlrange="-100 100" gear="20"/>
        <motor name="sixthMotor" joint="wheelR3" ctrllimited="true" ctrlrange="-100 100" gear="20"/>
    </actuator>

</mujoco>
