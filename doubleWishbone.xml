                            <joint type = "ball"/>
                            <geom type = "sphere" size = "0.03" />
                            <site name ="downLArm1" size = "0.03" rgba = "0 0 0 0.4"/>
                        </body>
                    </body>
                </body>

                <!--Right Upper Arm-->
                <body pos = "0.12 -0.27 0.1">
                    <joint type = "hinge" axis = "1 0 0"/>
                    <geom type = "cylinder" size ="0.03 0.03" euler = "0 90 0" rgba ="1 0 0 1"/>
                    <body>
                        <joint type = "hinge" axis = "1 0 0"/>
                        <geom type = "box" size = "0.03 0.2 0.03" pos = "0 -0.2 0"/> <!-- size = "0.03 N 0.03"... pos = "0 N 0"-->
                        <body pos = "0 -0.42 0"> <!-- body pos = "0 -(2*N+0.02) 0"-->
                            <joint type = "ball"/>
                            <geom type = "sphere" size = "0.03" />
                            <site name ="upRArm1" size = "0.03" rgba = "0 0 0 0.4"/>
                        </body>
                    </body>
                </body>

                <!--Right Lower Arm-->
                <body pos = "0.12 -0.27 -0.1">
                    <joint type = "hinge" axis = "1 0 0"/>
                    <geom type = "cylinder" size ="0.03 0.03" euler = "0 90 0" rgba ="1 0 0 1"/>
                    <body>
                        <joint type = "hinge" axis = "1 0 0"/>
                        <geom type = "box" size = "0.03 0.2 0.03" pos = "0 -0.2 0"/> <!-- size = "0.03 N 0.03"... pos = "0 N 0"-->
                        <body pos = "0 -0.42 0">
                            <joint type = "ball"/>
                            <geom type = "sphere" size = "0.03" />
                            <site name ="downRArm1" size = "0.03" rgba = "0 0 0 0.4"/>
                        </body>
                    </body>
                </body>

                <!--Wheels-->
                <body pos = "0.1 0.75 0">
                    <joint name = "wheelL1" type = "hinge" axis = "0 1 0"/>
                    <joint type = "hinge" axis = "1 0 0"/>
                    <geom type = "cylinder" euler = "90 0 0" size = "0.25 0.05"/>
                    <site name = "connectLUp1" size = "0.03" pos = "0 -0.05 0.15" rgba = "0 0 1 1"/>
                    <site name = "connectLDown1" size = "0.03" pos = "0 -0.05 -0.15" rgba = "0 0 1 1"/>
                </body>

                <body pos = "0.1 -0.75 0">
                    <joint name = "wheelR1" type = "hinge" axis = "0 1 0"/>
                    <joint type = "hinge" axis = "1 0 0"/>
                    <geom type = "cylinder" euler = "90 0 0" size = "0.25 0.05"/>
                    <site name = "connectRUp1" size = "0.03" pos = "0 0.05 0.15" rgba = "0 0 1 1"/>
                    <site name = "connectRDown1" size = "0.03" pos = "0 0.05 -0.15" rgba = "0 0 1 1"/>
                </body>

            </body>
            <!--Second pair-->
            <body pos = "-0.1 0 -0.25">
                <geom type = "box" size = "0.03 0.03 0.15" rgba = "1 1 0 1" pos = "0 -0.2 0"/>
                <geom type = "box" size = "0.03 0.03 0.15" rgba = "1 1 0 1" pos = "0 0.2 0"/>
                <geom type = "box" size = "0.03 0.3 0.03" rgba = "1 1 0 1" pos = "0.06 0 0.1"/>
                <geom type = "box" size = "0.03 0.3 0.03" rgba = "1 1 0 1" pos = "0.06 0 -0.1"/>

