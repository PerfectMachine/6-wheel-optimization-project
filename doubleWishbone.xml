<?xml version='1.0' encoding='UTF-8'?>
<mujoco>

	<option timestep="1e-4"/>
	<option gravity="0 0 -9.8"/>

    <worldbody>

        <!--Polygon-->
        <body name="floor" pos="0 0 0">
            <geom type="plane" size="10 10 0.1"/>
        </body>
        <!--Rover starts here-->
        <!--Base body-->
        <body pos = "0 0 1">
            <joint name = "cart" type = "free"/>
            <geom type = "box" size = "1 0.6 0.1"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.9 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.3 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.3 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.9 0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.9 -0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "0.3 -0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.3 -0.5 -0.2"/>
            <geom type = "box" size = "0.1 0.1 0.1" pos = "-0.9 -0.5 -0.2"/>

            <!--Wheel bases start here-->
            <!--First pair-->
            <body pos = "0.5 0 -0.25">
